<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Design Safe Zone (Center 66x66) -->

    <!-- Orange Sun -->
    <path
        android:pathData="M54,48m-25,0a25,25 0,1 1,50,0a25,25 0,1 1,-50,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="23"
                android:endX="54"
                android:endY="73"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF9100" />
                <item android:offset="1.0" android:color="#FFFF3D00" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Translucent Wave -->
    <path
        android:pathData="M24,65 Q39,55 54,65 T84,65 L84,80 Q54,85 24,80 Z"
        android:fillAlpha="0.7">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="65"
                android:endX="84"
                android:endY="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#AA00CCFF" />
                <item android:offset="1.0" android:color="#AA0066FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Yellow Exclamation Mark -->
    <path
        android:pathData="M52,28 L56,28 L55,55 L53,55 Z"
        android:fillColor="#FFEB3B" />
    <path
        android:pathData="M54,62m-3,0a3,3 0,1 1,6,0a3,3 0,1 1,-6,0"
        android:fillColor="#FFEB3B" />

</vector>