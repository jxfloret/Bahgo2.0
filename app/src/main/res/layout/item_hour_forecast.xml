<?xml version="1.0" encoding="utf-8"?>
<!-- One hour in the hourly rain strip: time, icon, chance of rain, temperature -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="58dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvHourTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_on_card"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivHourIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvHourChance"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/rain_chance"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHourTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_on_card"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
