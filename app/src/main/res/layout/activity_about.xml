<?xml version="1.0" encoding="utf-8"?>
<!--
    About BahGo: what the app is, how it works, data sources & APIs, legal documents,
    the developers, and contact. Same card style as Settings.
    The "How it works", "Data sources" and "Developers" lists are filled in AboutActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".AboutActivity">

    <!-- Starts below the header, so content never scrolls underneath it -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- App header -->
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_marginTop="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:contentDescription="@null"
                        android:src="@drawable/logo_round" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="BahGo"
                        android:textColor="@color/text_on_card"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_flood_watch_for_palar"
                        android:textColor="@color/text_on_card_secondary"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_button_solid"
                        android:backgroundTint="@color/card_muted"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/app_version"
                        android:textColor="@color/text_on_card_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView style="@style/SettingsSectionLabel" android:text="@string/about_about_bahgo" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="20dp"
                    android:text="@string/about_bahgo_is_a_flood"
                    android:textColor="@color/text_on_card"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- How it works -->
            <TextView style="@style/SettingsSectionLabel" android:text="@string/about_how_it_works" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:id="@+id/llHowItWorks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Data sources & APIs -->
            <TextView style="@style/SettingsSectionLabel" android:text="@string/about_data_sources_apis" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:id="@+id/llSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Legal -->
            <TextView style="@style/SettingsSectionLabel" android:text="@string/about_legal" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/rowAboutPrivacy" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_lock" />
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/about_privacy_policy" />
                            <TextView style="@style/SettingsRowValue" android:text="@string/about_what_we_collect_and" />
                        </LinearLayout>
                        <ImageView style="@style/SettingsRowChevron" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/rowAboutTerms" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_info" />
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/about_terms_and_conditions" />
                            <TextView style="@style/SettingsRowValue" android:text="@string/about_rules_for_using_bahgo" />
                        </LinearLayout>
                        <ImageView style="@style/SettingsRowChevron" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/rowAboutCookies" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_info" />
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/about_cookie_policy" />
                            <TextView style="@style/SettingsRowValue" android:text="@string/about_no_cookies_what_the" />
                        </LinearLayout>
                        <ImageView style="@style/SettingsRowChevron" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/rowAboutConsent" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_person" />
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/about_data_privacy_consent_form" />
                            <TextView style="@style/SettingsRowValue" android:text="@string/about_what_you_agreed_to" />
                        </LinearLayout>
                        <ImageView style="@style/SettingsRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Developers -->
            <TextView style="@style/SettingsSectionLabel" android:text="@string/about_developers" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        android:text="@string/about_4th_year_bs_computer"
                        android:textColor="@color/text_on_card_secondary"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:id="@+id/llTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact -->
            <TextView style="@style/SettingsSectionLabel" android:text="@string/about_contact" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/rowAboutAddress" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_location_pin" />
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="STI College Global City" />
                            <TextView android:id="@+id/tvAboutAddress" style="@style/SettingsRowValue" />
                        </LinearLayout>
                        <ImageView style="@style/SettingsRowChevron" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/rowAboutEmail" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_info" />
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/about_email_us" />
                            <TextView android:id="@+id/tvAboutEmail" style="@style/SettingsRowValue" />
                        </LinearLayout>
                        <ImageView style="@style/SettingsRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/about_bahgo_is_a_thesis"
                android:textColor="@color/intro_body"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Header Layered Last (Fixed on top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:elevation="6dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/icon_on_gradient" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/about_title"
            android:textColor="@color/text_on_gradient"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
