<?xml version="1.0" encoding="utf-8"?>
<!-- One example street in the Get Started illustration: dot, name, water bar, level label -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/vRowDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_button_solid" />

    <TextView
        android:id="@+id/tvRowName"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/text_on_card"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Water bar: track with a filled part -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_button_solid"
        android:backgroundTint="@color/card_muted"
        android:orientation="horizontal"
        android:weightSum="1">
        <View
            android:id="@+id/vRowFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:background="@drawable/bg_button_solid" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowLevel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
