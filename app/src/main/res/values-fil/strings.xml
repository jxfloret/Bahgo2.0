    <!-- Status info sheet -->
    <string name="info_level_what">Gaano kalalim ang baha sa kalye, sinusukat ng sensor na nakakabit sa itaas ng daan. Ang 0 cm ay nangangahulugang tuyo ang kalye.</string>
    <string name="info_level_safe">Ligtas · hanggang %1$s</string>
    <string name="info_level_safe_text">Hanggang bukung-bukong o mas mababa sa tuhod. Kadalasan, puwede pang maglakad o dumaan nang dahan-dahan.</string>
    <string name="info_level_warning">Babala · %1$s hanggang %2$s</string>
    <string name="info_level_warning_text">Hanggang tuhod. Mahirap maglakad at puwedeng tumirik ang maliliit na sasakyan. Iwasan kung kaya.</string>
    <string name="info_level_critical">Delikado · higit sa %1$s</string>
    <string name="info_level_critical_text">Hanggang baywang pataas. Delikado: huwag maglakad o dumaan.</string>
    <string name="info_level_tip">Ang \"%% ng threshold\" ay paghahambing ng tubig ngayon sa Delikadong level (%1$s = 100%%).</string>

    <string name="info_risk_what">Gaano ka-delikado ang kalyeng ito ngayon, base sa taas ng tubig.</string>
    <string name="info_risk_safe_text">Mababa sa %1$s ang tubig. Normal, pero mag-ingat pa rin kapag umuulan.</string>
    <string name="info_risk_warning_text">Nasa pagitan ng %1$s at %2$s ang tubig. Mag-ingat at iwasan ang kalye kung kaya.</string>
    <string name="info_risk_critical_text">Higit sa %1$s ang tubig. Lumayo sa lugar.</string>
    <string name="info_risk_offline_text">Hindi nagpapadala ng data ang sensor ngayon, kaya hindi alam ang panganib. Mag-ingat.</string>
    <string name="info_risk_tip">Makakatanggap ka ng notification kapag naging Babala o Delikado ang isang kalye (kung naka-on ang flood alerts sa Settings).</string>

    <string name="info_rise_what">Gaano kabilis tumataas o bumababa ang tubig, batay sa mga reading sa nakaraang 15 minuto.</string>
    <string name="info_rise_rising">+ cm/hr · tumataas</string>
    <string name="info_rise_rising_text">Tumataas ang tubig. Ang \"+6 cm/hr\" ay mga 6 cm na mas mataas sa loob ng isang oras. Kung patuloy itong tumaas, ipapakita ng kahon kung kailan ito aabot sa susunod na level, tulad ng \"Babala sa loob ng ~25 min\".</string>
    <string name="info_rise_steady_text">Halos hindi nagbabago ang tubig (wala pang %1$s kada oras).</string>
    <string name="info_rise_falling">- cm/hr · bumababa</string>
    <string name="info_rise_measuring_text">Kailangan muna ng app ng ilang minuto ng reading.</string>
    <string name="info_rise_tip">Ang mabilis na pagtaas ng tubig habang malakas ang ulan ay maagang senyales ng baha, kahit Ligtas pa ang level.</string>

    <string name="info_rain_what">Ano ang nararamdaman ng rain sensor sa kalyeng ito ngayon. Mas basa ang sensor, mas malakas ang ulan.</string>
    <string name="info_rain_none_text">Tuyo ang sensor.</string>
    <string name="info_rain_light_text">Ambon o manaka-nakang ulan. Maliit ang epekto sa baha.</string>
    <string name="info_rain_moderate_text">Tuloy-tuloy na ulan. Puwedeng magsimulang mag-ipon ang tubig sa mabababang kalye.</string>
    <string name="info_rain_heavy_text">Buhos ng ulan. Mabilis tumaas ang tubig: bantayan ang Bilis ng Pagtaas at Antas ng Panganib.</string>
    <string name="info_rain_tip">Hindi ibig sabihin ng ulan lang na may baha. Tingnan ang Taas ng Tubig para malaman kung gaano talaga kalalim.</string>

